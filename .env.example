# Contact Form Configuration (Optional)
# In development, if credentials are not set, submissions are saved locally to messages.txt.

# Option 1: Resend API Key (Recommended for Vercel/serverless)
# Sends from site.contactEmail (fredrick@vitalink.africa); vitalink.africa must stay verified in Resend.
# Each submission sends a notification to the inbox and a confirmation to the visitor.
RESEND_API_KEY=your_resend_api_key

# Option 2: Gmail SMTP fallback (notification only). App Password from Google Account > Security.
GMAIL_APP_PASSWORD=your_gmail_app_password
# Gmail account that signs in for the fallback (defaults to site.email)
GMAIL_USER=you@gmail.com

# Optional: inbox override for form messages (defaults to site.contactEmail in src/content/site.ts)
CONTACT_EMAIL=your_email@example.com

# Analytics Configuration (Optional)
# If omitted, Google Analytics is disabled with zero errors or bundle overhead.
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Canonical site URL used for metadata, sitemap and robots (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://fredrickakojuru.vercel.app
